# Forge job outputs stay on this PC; the job records next to them (job.json, explain.md,
# prompt-brief.md, prompt-review*.md, state.json) are committed as the history of each job.
art/jobs/*/out/

# Short-lived markers that stop two sessions colliding (forge_jobs.py busy markers, number claims, temp saves).
art/jobs/*/.busy
art/jobs/.claims/
art/jobs/*/patch*.json
art/.status.busy
.*.tmp

# Generated by `forge_jobs.py catalog` and `gallery`; rebuild them any time.
art/catalog.json
art/gallery.html

__pycache__/
